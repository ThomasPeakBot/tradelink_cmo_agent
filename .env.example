DATABASE_URL=postgresql://tradelink:local-development-only@localhost:5432/tradelink?schema=public
APP_URL=http://localhost:3000
# Optional; absence enables the clearly labeled local intelligence provider.
OPENAI_API_KEY=
# Alternative for cloud settings that reserve OPENAI_* names:
TRADELINK_OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set unique credentials before production. Demo defaults are permitted only outside production.
ADMIN_EMAIL=admin@tradelink.local
ADMIN_PASSWORD=
# Stripe is manual-sync only. Never use a full-access or test key.
STRIPE_SECRET_KEY=
# Required: comma-separated, verified TradeLink product IDs (never the whole PeakBot account).
STRIPE_PRODUCT_IDS=
# Optional read-only social reporting. Never use tokens in client-side variables.
X_BEARER_TOKEN=
X_USER_ID=
X_USERNAME=tradelink_pb
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=tradelink_pb
# Dedicated service account; share ONLY the approved TradeLink folder as Viewer.
# JSON credential is server-side only. Never commit its actual value.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Random 32+ character bearer secret shared only with the scheduled Railway trigger.
SYNC_CRON_SECRET=
# Optional identifier only; no paid X Ads adapter is connected yet.
X_ADS_ACCOUNT_ID=
